<?xml version="1.0" encoding="utf-8"?>
<!--
    App backup is disabled by android:allowBackup="false" in the manifest.
    The Room database is not encrypted; keep it explicitly excluded as defense in depth.
    API-key preferences and downloaded model files are excluded as well.
-->
<full-backup-content>
    <exclude domain="database" path="lumi.db" />
    <exclude domain="sharedpref" path="lumi_secure.xml" />
    <exclude domain="file" path="models/" />
</full-backup-content>
